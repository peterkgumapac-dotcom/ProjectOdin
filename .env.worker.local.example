VITE_SUPABASE_URL=https://xbanzimrojdsskavdvkk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local ODIN app login only. Do not put Slack/Gmail passwords here.
ODIN_SUPABASE_EMAIL=peterkgumapac@gmail.com
ODIN_SUPABASE_PASSWORD=replace-me

# Normal scans default to hidden/headless. Set false only for debugging.
ODIN_WORKER_HEADLESS=true
ODIN_WORKER_POLL_MS=5000
ODIN_BROWSER_DAEMON_PORT=8787

# Optional manual setup/debug browser.
# "playwright" uses bundled Chromium. "chrome" opens your installed Chrome
# with ODIN's dedicated local profile, not your normal personal Chrome profile.
ODIN_WORKER_BROWSER_CHANNEL=playwright
ODIN_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Optional advanced override if Chrome is installed somewhere custom.
# ODIN_WORKER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
